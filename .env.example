# Real-World News & Fact-Checking API Keys Configuration
# Optional: The system includes a zero-key live web fallback (Google News RSS & DuckDuckGo)

# NewsAPI (https://newsapi.org/) - Free developer key for live global news headlines
NEWS_API_KEY=

# Google Fact Check Tools API (https://developers.google.com/fact-check/tools/api)
# Queries verified ratings from Snopes, PolitiFact, FactCheck.org, Reuters Fact Check, AP Fact Check
GOOGLE_FACTCHECK_API_KEY=

# GNews API (https://gnews.io/) - Fast search across 60,000+ global news sources
GNEWS_API_KEY=
